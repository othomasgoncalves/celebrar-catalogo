# Copie para .env e preencha com valores proprios. O .env NAO vai para o repositorio.

# Segredo de assinatura do JWT (HS256). Minimo de 32 bytes / 256 bits.
# Gere um valor novo por ambiente, por exemplo:
#   openssl rand -base64 48
APP_JWT_SECRET=

# true somente atras de HTTPS (producao). Em dev local, HTTP, mantenha false.
APP_JWT_COOKIE_SECURE=false
