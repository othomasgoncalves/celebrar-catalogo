# Copie para .env e preencha com valores proprios. O .env NAO vai para o repositorio.
#
#   cp .env.example .env
#
# O docker compose le este arquivo automaticamente. Para rodar o backend fora do
# Docker, exporte as variaveis no shell antes de `./mvnw spring-boot:run`.

# ---------------------------------------------------------------------------
# Obrigatoria: sem ela a aplicacao nao sobe
# ---------------------------------------------------------------------------

# Segredo de assinatura do JWT (HS256). Minimo de 32 bytes / 256 bits.
# Gere um valor novo por ambiente, por exemplo:
#   openssl rand -base64 48
APP_JWT_SECRET=

# ---------------------------------------------------------------------------
# Obrigatorias em producao (tem padrao de dev local, nunca use em producao)
# ---------------------------------------------------------------------------

# true somente atras de HTTPS (producao). Liga o atributo Secure do cookie de
# sessao e o cabecalho HSTS. Em dev local, HTTP, mantenha false.
APP_JWT_COOKIE_SECURE=false

# Credenciais do PostgreSQL. O padrao versionado serve so para dev local.
POSTGRES_DB=celebrarcatalog
POSTGRES_USER=celebrarcatalog
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# Opcionais
# ---------------------------------------------------------------------------

# Validade da sessao do admin. Padrao: 8h
# APP_JWT_EXPIRACAO=8h

# Nome do cookie de sessao. Padrao: celebrar_sessao
# APP_JWT_COOKIE_NOME=celebrar_sessao

# Diretorio onde as imagens do catalogo sao gravadas. Precisa ser um volume
# persistente. No docker-compose.yml isso ja aponta para um volume nomeado.
# APP_IMAGENS_DIRETORIO=dados/imagens

# Conexao JDBC completa, se o banco nao for o do docker-compose.
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/celebrarcatalog
# SPRING_DATASOURCE_USERNAME=celebrarcatalog
# SPRING_DATASOURCE_PASSWORD=
